# Slack. Socket Mode is used when SLACK_APP_TOKEN is set. Otherwise Bolt
# serves HTTP on PORT and verifies requests with SLACK_SIGNING_SECRET.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Optional comma-separated Slack user IDs. Empty allows every user in the workspace.
# This is not role-based access control.
SLACK_ALLOWED_USER_IDS=

# Optional comma-separated channel IDs. Empty answers every channel the bot is in.
# Direct messages are always answered. Set this to one dedicated channel when the
# bot is also invited elsewhere.
SLACK_CHANNEL_IDS=

# Syncro. Use the account subdomain. /api/v1 is added when missing.
# Token permissions used by this app: Tickets list/view, Customers list/view, Assets list.
SYNCRO_BASE_URL=https://your-subdomain.syncromsp.com
SYNCRO_API_KEY=

# openai or openrouter. Both use the Chat Completions tool-calling API.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional. Defaults to https://api.openai.com/v1 or https://openrouter.ai/api/v1.
LLM_BASE_URL=

# HTTP port for /health and, in HTTP mode, Slack events.
PORT=3000

# Optional operating rules. SLA "due soon" is computed from due_date.
SLA_DUE_SOON_HOURS=24
# Pages of list results per tool call. Syncro page size is set by the API (often 25-100).
SYNCRO_MAX_PAGES=4
SYNCRO_TIMEOUT_MS=20000
