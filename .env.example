# Slack tokens are minted by `bdk slack create` into .env.local as
# SYNCRON_JR_SLACK_BOT_TOKEN and SYNCRON_JR_SLACK_APP_TOKEN.

# Syncro. Use the account subdomain. /api/v1 is added when missing.
# Token permissions used by this app: Tickets list/view, Customers list/view, Assets list.
SYNCRO_BASE_URL=https://your-subdomain.syncromsp.com
SYNCRO_API_KEY=

# Optional comma-separated Slack user IDs. Empty allows every user in the workspace.
SLACK_ALLOWED_USER_IDS=

# Optional operating rules. SLA "due soon" is computed from due_date.
SLA_DUE_SOON_HOURS=24
# Pages of list results per tool call. Syncro page size is set by the API (often 25-100).
SYNCRO_MAX_PAGES=4
SYNCRO_TIMEOUT_MS=20000
