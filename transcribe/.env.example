# Copy this file to .env.local and fill in only the providers you use.
# .env.local is gitignored. The server reads it at startup and never logs the values.
# A key typed in the browser overrides the matching variable for that request.
# Leave the page field blank to use the value from this file.

OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# Optional. Default is 8787. The server binds to 127.0.0.1 only.
PORT=8787
